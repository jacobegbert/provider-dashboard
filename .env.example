# MySQL connection string. Leave unset to run the in-memory demo.
# Do not put real patient information in the in-memory store.
# Railway can inject this as ${{MySQL.DATABASE_URL}}.
# After the first real database is created, apply the schema with: pnpm db:push
DATABASE_URL=mysql://user:password@host:3306/dbname

# Secret for signing session cookies. Required in production.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Optional. The portal uses a deterministic stub unless both are set.
# Never commit a real key. Suggestions stay clinician-only drafts.
# GUIDANCE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# GUIDANCE_MODEL=claude-3-5-haiku-latest

# Pharmacy adapter. Only "mock" is implemented. Any other value falls back to mock.
# PHARMACY_ADAPTER=mock

# Charm Health FHIR. Leave unset, or set CHARM_ADAPTER=mock, to use the fictional feed.
# CHARM_ADAPTER=live reads these at runtime and is never required for the demo or the tests.
# SMART backend auth uses CHARM_PRIVATE_KEY (PEM, RS384 client assertion).
# CHARM_CLIENT_SECRET is the fallback when the tenant issues a confidential client secret.
# CHARM_ADAPTER=live
# CHARM_FHIR_BASE_URL=https://example.invalid/fhir/r4
# CHARM_TOKEN_URL=https://example.invalid/oauth/token
# CHARM_CLIENT_ID=
# CHARM_CLIENT_SECRET=
# CHARM_PRIVATE_KEY=
# CHARM_SCOPE=system/Patient.read system/Observation.read system/DiagnosticReport.read system/MedicationRequest.read

# Downstream hub delivery. Mock unless HUB_DELIVERY=live and that destination's secret is set.
# Destinations also have an in-app kill switch, which defaults to on.
# HUB_DELIVERY=live
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# VIKTOR_SLACK_CHANNEL_ID=
# GHL_API_TOKEN=
# GHL_LOCATION_ID=
# HUB_WEBHOOK_URL=

# HTTP port. Defaults to 3000.
# PORT=3000
